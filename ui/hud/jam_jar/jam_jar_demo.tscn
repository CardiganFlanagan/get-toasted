[gd_scene format=3 uid="uid://cx545ar3km4mh"]

[ext_resource type="PackedScene" uid="uid://0bh1edmyq271" path="res://ui/hud/jam_jar/jam_jar.tscn" id="2_jar"]

[sub_resource type="GDScript" id="GDScript_ffu2k"]
script/source = "extends Control
## Демо банок: Пробел или тап — урон, H — лечение, M — потратить ману, R — бег, 1/2/3 — вкус.

@onready var hp_jar: JamJar = $HealthJar
@onready var mana_jar: JamJar = $ManaJar

var hp := 100.0
var mana := 100.0
var running := false


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventScreenTouch and event.is_pressed():
		_damage()
		return
	var key := event as InputEventKey
	if key == null or not key.pressed or key.echo:
		return
	match key.keycode:
		KEY_SPACE:
			_damage()
		KEY_H:
			hp = minf(hp + 20.0, 100.0)
			hp_jar.set_value(hp, 100.0)
		KEY_M:
			mana = maxf(mana - 30.0, 0.0) if mana > 0.0 else 100.0
			mana_jar.set_value(mana, 100.0)
		KEY_R:
			running = not running
			hp_jar.set_running(running)
			mana_jar.set_running(running)
		KEY_1, KEY_2, KEY_3:
			hp_jar.flavor = (key.keycode - KEY_1) as JamJar.Flavor


func _damage() -> void:
	hp = maxf(hp - 15.0, 0.0)
	hp_jar.set_value(hp, 100.0)
"

